{
  "name": "assay",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only integrity layer for tokenized stocks on Base.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @assay/web dev",
    "build:mcp": "pnpm --filter @assay/mcp build",
    "pipeline": "pnpm --filter @assay/pipeline run run"
  },
  "bin": {
    "assay-mcp": "packages/mcp/dist/assay-mcp.mjs"
  }
}
